# Dummy values only - StripeClient is resolved via DI on every checkout
# request (even cash-on-delivery), so it needs *some* non-null config to
# construct without throwing. No real Stripe API call happens in the e2e
# suite since the tests use payment_method=cod.
STRIPE_KEY=pk_test_e2e_dummy
STRIPE_SECRET=sk_test_e2e_dummy
STRIPE_WEBHOOK_SECRET=whsec_e2e_dummy
